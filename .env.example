# OpenShock Roulette environment settings
# Copy this file to .env and fill in your values. .env should stay out of Git.

PORT=8787
HOST=0.0.0.0

# OpenShock API
OPENSHOCK_API_TOKEN=
OPENSHOCK_API_HOST=api.openshock.app
# Optional override. Leave commented to use package.json version automatically.
# OPENSHOCK_USER_AGENT=

# SQLite state database
OSR_DB_PATH=./data/osr.db
