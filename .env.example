# OpenShock Roulette v1.3.0 environment settings
# Copy this file to .env and fill in your values. .env should stay out of Git.

PORT=8787
HOST=0.0.0.0

# OpenShock API
OPENSHOCK_API_TOKEN=
OPENSHOCK_API_HOST=api.openshock.app
OPENSHOCK_USER_AGENT=OpenShock-Roulette/1.3.0 (local-party-game)

# SQLite state database
OSR_DB_PATH=./data/osr.db
