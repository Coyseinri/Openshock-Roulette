{
  "name": "openshock-roulette",
  "version": "1.4.0",
  "description": "A local browser-based roulette party game for OpenShock.",
  "main": "server.js",
  "scripts": {
    "start": "node --no-warnings server.js",
    "test": "node --test tests/*.test.js",
